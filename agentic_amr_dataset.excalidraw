      "updated": 1794860000000,
      "created": 1794860000000,
      "link": null,
      "locked": false,
      "customData": {
        "section": "agent-pipeline"
      },
      "text": "Every worker takes one article and shares nothing, so a shard splits\narticles by id and several machines can run the same command at the same\ntime. A retry, a crash or an extra worker never touches another article's\nwork.",
      "fontSize": 14,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every worker takes one article and shares nothing, so a shard splits\narticles by id and several machines can run the same command at the same\ntime. A retry, a crash or an extra worker never touches another article's\nwork.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
