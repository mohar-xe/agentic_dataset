    {
      "id": "agent-pipeline-text-106",
      "type": "text",
      "x": 680,
      "y": 3902.0,
      "width": 840,
      "height": 227.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
