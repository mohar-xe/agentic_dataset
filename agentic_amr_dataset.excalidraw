      "text": "Rewrite the sentence when a mention resolves",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rewrite the sentence when a mention resolves",
