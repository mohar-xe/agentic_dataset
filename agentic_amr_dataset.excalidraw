      },
      "text": "Check, repair, reject",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Check, repair, reject",
