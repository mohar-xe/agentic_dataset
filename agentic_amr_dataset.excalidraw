      "isDeleted": false,
      "boundElements": null,
      "updated": 1794860000000,
      "created": 1794860000000,
      "link": null,
      "locked": false,
      "customData": {
        "section": "agent-pipeline"
      },
      "text": "Nothing is written unchecked: a sentence the\nagent never parsed has no crutch to edit, and\none that still fails the check keeps its\nreason in rejected.jsonl.",
      "fontSize": 13,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nothing is written unchecked: a sentence the\nagent never parsed has no crutch to edit, and\none that still fails the check keeps its\nreason in rejected.jsonl.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
