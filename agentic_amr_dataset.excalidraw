      "index": "b3F",
      "roundness": null,
      "seed": 1163933217,
      "version": 1,
      "versionNonce": 2076529526,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794860000000,
      "created": 1794860000000,
      "link": null,
      "locked": false,
      "customData": {
        "section": "agent-pipeline"
      },
      "text": "EXAMPLE — article 5772, batch 3\n\"The Importance of Determination of Seat under Indian Arbitration Law\"\n53 sentences, in order\n\n360450  The award was challenged under section 34 ...\n360477  ... that the Act still provides no reference ...\n\nto the model:  2 whole paragraphs, unsplit, in order\n               the title and the memory\nback:          { original, sentence, amr, edits[], entities[],\n                 status }  ·  original = the text it split\n\nor a tool call first, answered once the name is known",
      "fontSize": 14,
      "baseFontSize": null,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "EXAMPLE — article 5772, batch 3\n\"The Importance of Determination of Seat under Indian Arbitration Law\"\n53 sentences, in order\n\n360450  The award was challenged under section 34 ...\n360477  ... that the Act still provides no reference ...\n\nto the model:  2 whole paragraphs, unsplit, in order\n               the title and the memory\nback:          { original, sentence, amr, edits[], entities[],\n                 status }  ·  original = the text it split\n\nor a tool call first, answered once the name is known",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
