      "locked": false,
      "text": "How wiki matching works (phonebook fetch + lookup)",
      "originalText": "How wiki matching works (phonebook fetch + lookup)",
      "fontSize": 22,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 17.6,
