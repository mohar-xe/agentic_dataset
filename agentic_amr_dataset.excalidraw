      "customData": {
        "section": "agent-one"
      },
      "text": "candidates are shown with evidence (no numeric score); the agent picks\nmemory, exact name/alias: direct match already resolved in this article\nsame sentence, name before mention: strongest text evidence in place\nearlier sentence (alias match/name match): earlier declaration, with distance\narticle metadata: name listed for the whole article\nmemory, same kind only: weak hint, not proof\nno clear single answer (none, or several equally plausible) -> reject, don't guess",
      "fontSize": 11.5,
      "baseFontSize": null,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "candidates are shown with evidence (no numeric score); the agent picks\nmemory, exact name/alias: direct match already resolved in this article\nsame sentence, name before mention: strongest text evidence in place\nearlier sentence (alias match/name match): earlier declaration, with distance\narticle metadata: name listed for the whole article\nmemory, same kind only: weak hint, not proof\nno clear single answer (none, or several equally plausible) -> reject, don't guess",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
