    },
    {
      "id": "agent-pipeline-text-090",
      "type": "text",
      "x": 112,
      "y": 3365.0,
      "width": 510,
      "height": 131.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2z",
      "roundness": null,
      "seed": 1035770049,
      "version": 1,
      "versionNonce": 1664628613,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794860000000,
      "created": 1794860000000,
      "link": null,
      "locked": false,
      "customData": {
        "section": "agent-pipeline"
      },
      "text": "A batch is two or three whole paragraphs, joined the way the\ncorpus stored them and never pre-split. The agent splits them\nitself, then calls spring_parse once per sentence — all the\ncalls for a paragraph in one turn, so they run at the same\ntime. spring_parse is a plain parser call: sentence in,\nclassic AMR out, nothing else. Those graphs are the crutch it\nedits, and a sentence it never parsed is rejected.",
      "fontSize": 15,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A batch is two or three whole paragraphs, joined the way the\ncorpus stored them and never pre-split. The agent splits them\nitself, then calls spring_parse once per sentence — all the\ncalls for a paragraph in one turn, so they run at the same\ntime. spring_parse is a plain parser call: sentence in,\nclassic AMR out, nothing else. Those graphs are the crutch it\nedits, and a sentence it never parsed is rejected.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
