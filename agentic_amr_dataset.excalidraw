    {
      "id": "agent-one-text-163",
      "type": "text",
      "x": 40,
      "y": 6491.0,
      "width": 1480,
      "height": 80.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
