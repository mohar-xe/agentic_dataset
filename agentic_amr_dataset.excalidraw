    {
      "id": "agent-pipeline-text-136",
      "type": "text",
      "x": 112,
      "y": 4931.5,
      "width": 510,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3j",
      "roundness": null,
      "seed": 802146892,
      "version": 1,
      "versionNonce": 103993368,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794860000000,
      "created": 1794860000000,
      "link": null,
      "locked": false,
      "customData": {
        "section": "agent-pipeline"
      },
      "text": "Only the mention changes; every other character stays the\nsame. The original sentence is always kept next to the\nresolved one, so nothing is lost.",
      "fontSize": 15,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Only the mention changes; every other character stays the\nsame. The original sentence is always kept next to the\nresolved one, so nothing is lost.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
