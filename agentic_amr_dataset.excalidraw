      "customData": {
        "section": "agent-pipeline"
      },
      "text": "Outputs are append-only, so a crash costs at most one batch. A\nfinished article is skipped next time, and a half-finished one\ncontinues from its last checkpoint.",
      "fontSize": 15,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Outputs are append-only, so a crash costs at most one batch. A\nfinished article is skipped next time, and a half-finished one\ncontinues from its last checkpoint.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
