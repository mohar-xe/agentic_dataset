      "link": null,
      "locked": false,
      "customData": {
        "section": "agent-pipeline"
      },
      "text": "EXAMPLE — sentence 360477\nbefore  ... that the Act still provides no reference ...\nafter   ... that the Arbitration and Conciliation Act, 1996\n            still provides no reference ...\n\nedit { surface: \"Act\", occurrence: 1,\n       replacement: \"Arbitration and Conciliation Act, 1996\",\n       resolved_to: \"a1\", evidence: \"article\", kind: \"statute\" }\n      (the word before it, \"the\", stays in the sentence)\n\nsentence_original keeps the corpus text",
      "fontSize": 14,
      "baseFontSize": null,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "EXAMPLE — sentence 360477\nbefore  ... that the Act still provides no reference ...\nafter   ... that the Arbitration and Conciliation Act, 1996\n            still provides no reference ...\n\nedit { surface: \"Act\", occurrence: 1,\n       replacement: \"Arbitration and Conciliation Act, 1996\",\n       resolved_to: \"a1\", evidence: \"article\", kind: \"statute\" }\n      (the word before it, \"the\", stays in the sentence)\n\nsentence_original keeps the corpus text",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
