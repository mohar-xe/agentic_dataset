    {
      "id": "agent-pipeline-text-145",
      "type": "text",
      "x": 680,
      "y": 5188.0,
      "width": 840,
      "height": 227.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3s",
      "roundness": null,
      "seed": 1438843662,
      "version": 1,
      "versionNonce": 169841660,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794860000000,
      "created": 1794860000000,
      "link": null,
      "locked": false,
      "customData": {
        "section": "agent-pipeline"
      },
      "text": "EXAMPLE — the check, both directions\npass  edit found · name in graph · graph parses\nfail  :legal-type may appear only on a gov-entity,\n      got 'court'\n      -> (h / court) becomes (h / gov-entity)\nfail  edit span not found: 'NOTHERE' occurrence 1\nfail  name \"Arbitration and Conciliation Act, 1996\"\n      missing from graph\n\nstill failing after two tries, or nothing to resolve:\n\"the Scheme\"  -> no_credible_source\n\"the Board\"   -> ambiguous_antecedent\n  rejected.jsonl keeps the reason and the candidates",
      "fontSize": 14,
      "baseFontSize": null,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "EXAMPLE — the check, both directions\npass  edit found · name in graph · graph parses\nfail  :legal-type may appear only on a gov-entity,\n      got 'court'\n      -> (h / court) becomes (h / gov-entity)\nfail  edit span not found: 'NOTHERE' occurrence 1\nfail  name \"Arbitration and Conciliation Act, 1996\"\n      missing from graph\n\nstill failing after two tries, or nothing to resolve:\n\"the Scheme\"  -> no_credible_source\n\"the Board\"   -> ambiguous_antecedent\n  rejected.jsonl keeps the reason and the candidates",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
