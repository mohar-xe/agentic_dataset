      "link": null,
      "locked": false,
      "customData": {
        "section": "agent-pipeline"
      },
      "text": "Read the article in order, one batch at a time",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Read the article in order, one batch at a time",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "agent-pipeline-text-104",
      "type": "text",
      "x": 112,
      "y": 3926.0,
      "width": 510,
      "height": 93.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3D",
      "roundness": null,
      "seed": 1838560262,
      "version": 1,
      "versionNonce": 457835526,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794860000000,
      "created": 1794860000000,
      "link": null,
      "locked": false,
      "customData": {
        "section": "agent-pipeline"
      },
      "text": "Sentences are read from the corpus DB in the article's order\nand sent eight at a time, so a declaration is always seen\nbefore the short mentions that depend on it. One article is\none independent task, so many articles can run side by side\nwithout sharing anything.",
      "fontSize": 15,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sentences are read from the corpus DB in the article's order\nand sent eight at a time, so a declaration is always seen\nbefore the short mentions that depend on it. One article is\none independent task, so many articles can run side by side\nwithout sharing anything.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
