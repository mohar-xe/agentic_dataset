      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "agent-pipeline-text-143",
      "type": "text",
      "x": 112,
      "y": 5212.0,
      "width": 510,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3q",
      "roundness": null,
      "seed": 567654032,
      "version": 1,
      "versionNonce": 420435053,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794860000000,
      "created": 1794860000000,
      "link": null,
      "locked": false,
      "customData": {
        "section": "agent-pipeline"
      },
      "text": "One check reads both sides: the edit must exist in the\nsentence, the specific name must exist in the graph, and the\ngraph must parse. When it fails, the same conversation gets\nthe exact errors back and another try, base graph still in\nhand and tools still available. Up to two tries; what still\nfails is rejected, never written unchecked.",
      "fontSize": 15,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One check reads both sides: the edit must exist in the\nsentence, the specific name must exist in the graph, and the\ngraph must parse. When it fails, the same conversation gets\nthe exact errors back and another try, base graph still in\nhand and tools still available. Up to two tries; what still\nfails is rejected, never written unchecked.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
