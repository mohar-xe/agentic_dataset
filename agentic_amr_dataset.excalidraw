    },
    {
      "id": "agent-one-text-445",
      "type": "text",
      "x": 40,
      "y": 10994.62,
      "width": 1480,
      "height": 40.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8i",
      "roundness": null,
      "seed": 1956122416,
      "version": 1,
      "versionNonce": 2053796632,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794860000000,
      "created": 1794860000000,
      "link": null,
      "locked": false,
      "customData": {
        "section": "agent-one"
      },
      "text": "One of the six sentences is not in the dataset. That is a result, not a failure: the sentence says less than a name needs, so the agent stops instead\nof inventing one.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One of the six sentences is not in the dataset. That is a result, not a failure: the sentence says less than a name needs, so the agent stops instead\nof inventing one.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
