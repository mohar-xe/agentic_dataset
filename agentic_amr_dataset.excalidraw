    {
      "id": "agent-pipeline-text-115",
      "type": "text",
      "x": 130,
      "y": 4385.0,
      "width": 1332,
      "height": 195.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3O",
      "roundness": null,
      "seed": 2126805496,
      "version": 1,
      "versionNonce": 381593934,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794860000000,
      "created": 1794860000000,
      "link": null,
      "locked": false,
      "customData": {
        "section": "agent-pipeline"
      },
      "text": "paragraph 6 of 5772, unsplit, one string\n  \"The award was challenged under section 34 of the Act. The\n   Court held that the award was set aside.\"\n\nthe agent splits it itself, then in ONE turn:\n  spring_parse(sentence=\"The award was challenged under ...\")\n  spring_parse(sentence=\"The Court held that ...\")      (calls run\n  spring_parse(sentence=\"The award was set aside.\")       in parallel)\n\nback, once per call:  (z1 / obligate-01 ...)  7 nodes, 11 edges · valid\n-> that graph is what the agent edits. The tool knows nothing about the\n   article — no ids, no memory: it is SPRING on one sentence.",
      "fontSize": 13,
      "baseFontSize": null,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "paragraph 6 of 5772, unsplit, one string\n  \"The award was challenged under section 34 of the Act. The\n   Court held that the award was set aside.\"\n\nthe agent splits it itself, then in ONE turn:\n  spring_parse(sentence=\"The award was challenged under ...\")\n  spring_parse(sentence=\"The Court held that ...\")      (calls run\n  spring_parse(sentence=\"The award was set aside.\")       in parallel)\n\nback, once per call:  (z1 / obligate-01 ...)  7 nodes, 11 edges · valid\n-> that graph is what the agent edits. The tool knows nothing about the\n   article — no ids, no memory: it is SPRING on one sentence.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
