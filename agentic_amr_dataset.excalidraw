    },
    {
      "id": "1d9ca17cdd794b86937715c8fd2c2428",
      "type": "text",
      "x": 40,
      "y": 887,
      "width": 850.1999999999999,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 691580321,
      "version": 3,
      "versionNonce": 1904072623,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794857010665,
      "link": null,
      "locked": false,
      "text": "FETCH/BUILD (one-time, scripts/wikidb/build.py, extend.py): downloads Wikipedia + Wikidata over the internet,",
      "originalText": "FETCH/BUILD (one-time, scripts/wikidb/build.py, extend.py): downloads Wikipedia + Wikidata over the internet,",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 10.4,
      "index": "b0D",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "079e616ebf6543d18fdbe6bba3b5f380",
      "type": "text",
      "x": 40,
      "y": 905,
      "width": 881.4,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 834247191,
      "version": 3,
      "versionNonce": 1336934081,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794857010665,
      "link": null,
      "locked": false,
      "text": "crawls categories -> gets article titles/Q-ids/labels/aliases/redirects/types -> saves a local SQLite 'phonebook'",
      "originalText": "crawls categories -> gets article titles/Q-ids/labels/aliases/redirects/types -> saves a local SQLite 'phonebook'",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 10.4,
      "index": "b0E",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "593f7ab5bb584d318eefaa5249756982",
      "type": "text",
      "x": 40,
      "y": 923,
      "width": 803.4,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 407688746,
      "version": 3,
      "versionNonce": 1113917903,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794857010665,
      "link": null,
      "locked": false,
      "text": "(e.g. data/wiki/india.db).  LOOKUP (step 5, resolve.py): searches that local DB only, no live internet.",
      "originalText": "(e.g. data/wiki/india.db).  LOOKUP (step 5, resolve.py): searches that local DB only, no live internet.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
