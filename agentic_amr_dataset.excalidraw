      "isDeleted": false,
      "boundElements": null,
      "updated": 1794860000000,
      "created": 1794860000000,
      "link": null,
      "locked": false,
      "customData": {
        "section": "agent-one"
      },
      "text": "Sentence 360450 of article 5772 first, followed from the moment the agent reads it to the moment it is saved. Each card is one moment, in order:\nread, remember, ask, rewrite, draw, repair, check, remember, save. Then all six sentences of the article side by side, the same nine moments each,\nand the one that was rejected, with the reason. The sentences, the scores, both graphs, the validator output and the memory lists are the real ones\nin data/five/report.json and data/five_repair/report.json. No model API was called.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sentence 360450 of article 5772 first, followed from the moment the agent reads it to the moment it is saved. Each card is one moment, in order:\nread, remember, ask, rewrite, draw, repair, check, remember, save. Then all six sentences of the article side by side, the same nine moments each,\nand the one that was rejected, with the reason. The sentences, the scores, both graphs, the validator output and the memory lists are the real ones\nin data/five/report.json and data/five_repair/report.json. No model API was called.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
