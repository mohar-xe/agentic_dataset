   "locked": false,
   "customData": {
    "section": "lean-amr-v11"
   },
   "text": "A legal text, a piece of a legal text, a court or ministry, and a court decision. Each is a plain noun. The kind of provision or body is kept as a\ndetail (see section 3), so seven names do the work.",
   "fontSize": 14,
   "baseFontSize": null,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A legal text, a piece of a legal text, a court or ministry, and a court decision. Each is a plain noun. The kind of provision or body is kept as a\ndetail (see section 3), so seven names do the work.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
