   "text": "(z1 / hold-02\n      :ARG0 (z2 / government-organization\n            :name (z3 / name\n                  :op1 \"Supreme\"\n                  :op2 \"Court\"\n                  :op3 \"of\"\n                  :op4 \"India\"))\n      :ARG1 (z4 / and\n            :op1 (z5 / restrict-01\n                  :ARG1 (z6 / scope\n                        :mod (z7 / interfere-01\n                              :ARG0 (z8 / judiciary)\n                              :ARG1 (z9 / award-01\n                                    :mod (z10 / arbitral))))\n                  :ARG2 (z11 / ground\n                        :ARG1-of (z12 / enumerate-01\n                              :ARG0 (z13 / section\n                                    :mod 34\n                                    :part-of (z14 / law\n                                          :name (z15 / name\n                                                :op1 \"Arbitration\"\n                                                :op2 \"and\"\n                                                :op3 \"Conciliation\"\n                                                :op4 \"Act\"))\n                                    :time (z16 / date-entity\n                                          :year 1996)))))\n            :op2 (z17 / extend-01\n                  :polarity -\n                  :ARG1 z7\n                  :ARG4 (z18 / appreciate-01\n                        :ARG1 (z19 / evidence-01)\n                        :mod (z20 / again))))\n      :ARG1-of (z21 / follow-01\n            :ARG2 (z22 / law\n                  :name (z23 / name\n                        :op1 \"Arbitration\"\n                        :op2 \"and\"\n                        :op3 \"Conciliation\"\n                        :op4 \"Act\")\n                  :time (z24 / date-entity\n                        :year 2015)\n                  :ARG0-of (z25 / amend-01\n                        :ARG1 z13))))",
